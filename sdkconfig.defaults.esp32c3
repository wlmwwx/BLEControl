CONFIG_BLINK_LED_STRIP=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_HID_ENABLED=y
CONFIG_BT_NIMBLE_HID_SERVICE=y
# We register one HID service per report map (keyboard, mouse, consumer).
# Default is 2, which makes the 3rd one fail with BLE_HS_ENOMEM.
CONFIG_BT_NIMBLE_SVC_HID_MAX_INSTANCES=3
CONFIG_ESP_HTTP_SERVER_ENABLED=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_OTA_CRASH_DUMP_STALL_WORKAROUND=y
